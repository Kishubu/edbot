# Copier en state/config.ini puis : chmod 600 state/config.ini

[ecoledirecte]
# Identifiants du compte PARENT (ceux du site / de l'appli).
identifiant =
motdepasse =

[whatsapp]
# Nom du groupe WhatsApp surveillé par le bot.
group = Ecoledirect

[notifications]
# Fréquence de vérification, en minutes.
poll_interval_minutes = 5
# Panne d'École Directe signalée seulement après ce nombre d'heures d'échec continu.
outage_alert_hours = 24
# Mot de passe refusé signalé seulement après ce nombre de minutes de refus continu.
auth_alert_minutes = 60

# Section FACULTATIVE : transfert de la messagerie École Directe par mail (Gmail).
# Supprimer toute la section pour désactiver.
[mail]
# Adresse Gmail expéditrice.
smtp_user =
# Mot de passe d'APPLICATION Gmail (compte Google > Sécurité > Mots de passe des applications).
smtp_password =
# Destinataire(s), séparés par des virgules.
destinataire =
